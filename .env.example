# Copy to .env and fill in secrets. Never commit .env.

# Data
RP_DATA_DIR=data
# RP_SQLITE_PATH=data/rpengine.sqlite

# Logging
RP_LOG_LEVEL=info
# RP_LOG_JSON=1

# Agents: mock | llm  (default: llm if RP_LLM_API_KEY is set, else mock)
# RP_AGENTS_MODE=llm

# LLM (Responses API: POST {RP_LLM_BASE_URL}/responses)
RP_LLM_API_KEY=g2a_your_api_key
RP_LLM_BASE_URL=http://127.0.0.1:8080/v1
RP_LLM_MODEL=your-model-name
# RP_LLM_TIMEOUT_MS=60000

# Optional live smoke (not used by default CI)
# RP_LIVE_LLM=1

# Working memory: last N user/assistant pairs in narrative.write
RP_WORKING_MEMORY_WINDOW=12
