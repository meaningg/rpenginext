{
  "name": "rpengineext",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*", "packages/*/*", "apps/*"],
  "scripts": {
    "test": "bun test",
    "test:logger": "bun test packages/logger",
    "test:contracts": "bun test packages/contracts",
    "test:core": "bun test packages/core",
    "test:persistence": "bun test packages/persistence/sqlite",
    "test:agents-responses": "bun test packages/agents/responses",
    "test:working-memory": "bun test packages/modules/working-memory",
    "test:host-bootstrap": "bun test packages/host-bootstrap",
    "test:content-stories": "bun test packages/content-stories",
    "test:api": "bun test apps/api",
    "test:e2e": "bun test apps/api/tests/playable.e2e.test.ts",
    "test:e2e:live": "bun test apps/api/tests/playable.live.e2e.test.ts",
    "smoke:play": "bun run apps/api/scripts/play-smoke.ts",
    "smoke:play:live": "bun run apps/api/scripts/play-smoke.ts --live",
    "smoke:play:mock": "bun run apps/api/scripts/play-smoke.ts --mock",
    "typecheck": "bunx tsc --noEmit -p packages/logger/tsconfig.json && bunx tsc --noEmit -p packages/contracts/tsconfig.json && bunx tsc --noEmit -p packages/core/tsconfig.json && bunx tsc --noEmit -p packages/persistence/sqlite/tsconfig.json && bunx tsc --noEmit -p packages/agents/responses/tsconfig.json && bunx tsc --noEmit -p packages/modules/working-memory/tsconfig.json && bunx tsc --noEmit -p packages/host-bootstrap/tsconfig.json && bunx tsc --noEmit -p packages/content-stories/tsconfig.json && bunx tsc --noEmit -p apps/cli/tsconfig.json && bunx tsc --noEmit -p apps/api/tsconfig.json",
    "start": "bun run index.ts",
    "cli": "bun run apps/cli/src/main.ts",
    "cli:hello": "bun run apps/cli/src/main.ts --once hello",
    "cli:book": "bun run apps/cli/src/main.ts --repl",
    "api": "bun run apps/api/src/main.ts",
    "api:mock": "bun run apps/api/src/main.ts --mock",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build"
  },
  "dependencies": {
    "@rpengineext/logger": "workspace:*",
    "@rpengineext/contracts": "workspace:*",
    "@rpengineext/core": "workspace:*",
    "@rpengineext/persistence-sqlite": "workspace:*",
    "@rpengineext/agents-responses": "workspace:*",
    "@rpengineext/module-working-memory": "workspace:*",
    "@rpengineext/content-stories": "workspace:*",
    "@rpengineext/host-bootstrap": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
