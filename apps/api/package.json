{
  "name": "@rpengineext/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP host for rpengineext (REST + SSE)",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rpengineext/content-stories": "workspace:*",
    "@rpengineext/contracts": "workspace:*",
    "@rpengineext/core": "workspace:*",
    "@rpengineext/host-bootstrap": "workspace:*",
    "@rpengineext/logger": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
